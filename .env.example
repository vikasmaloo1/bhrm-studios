# BHMR Studios — Environment Variables Template
# -----------------------------------------------
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# This file contains placeholders only — no real values.

# -----------------------------------------------
# Site Configuration
# -----------------------------------------------
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------

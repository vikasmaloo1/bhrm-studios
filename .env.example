GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# -----------------------------------------------
# HubSpot CRM Integration
# -----------------------------------------------
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# -----------------------------------------------
# Analytics
# -----------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=

# -----------------------------------------------
# Email / Notifications (if needed)
